APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# SQLAlchemy async URL. SQLite for MVP.
DATABASE_URL=sqlite+aiosqlite:///./guidloc.db

# Auth / JWT. Generate a strong random value for production.
JWT_SECRET=change-me-to-a-random-secret-with-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30


# LLM
LLM_PROVIDER=echo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AGENT_MAX_TURNS=40
